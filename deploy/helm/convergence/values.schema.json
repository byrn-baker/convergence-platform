{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "existingSecret": {
      "type": "string"
    },
    "siteConfig": {
      "type": "object",
      "minProperties": 1
    },
    "api": {
      "type": "object",
      "properties": {
        "rateLimitPerMinute": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "image": {
          "type": "object",
          "properties": {
            "tag": {
              "type": "string"
            }
          }
        },
        "service": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "ClusterIP",
                "NodePort"
              ]
            },
            "nodePort": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 30000,
              "maximum": 32767
            }
          }
        }
      }
    },
    "agentMetrics": {
      "type": "object",
      "properties": {
        "quota": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "modelRegex": {
              "type": "string"
            },
            "weeklyTokenBudget": {
              "type": [
                "number",
                "string"
              ],
              "minimum": 0
            },
            "projectionWarnRatio": {
              "type": [
                "number",
                "string"
              ],
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "burnCriticalRatio": {
              "type": [
                "number",
                "string"
              ],
              "exclusiveMinimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "reviewer": {
      "type": "object",
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        },
        "required": [
          "enabled"
        ]
      },
      "then": {
        "required": [
          "publicOrigin",
          "apiImage",
          "hudImage",
          "databaseSecret",
          "serviceTlsSecret",
          "installationTlsSecret",
          "browserTlsSecret"
        ],
        "properties": {
          "publicOrigin": {
            "type": "string",
            "pattern": "^https://([a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?\\.)*[a-z]([-a-z0-9]{0,61}[a-z0-9])?(:[1-9][0-9]{0,4})?$",
            "maxLength": 270
          },
          "apiImage": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^@\\s]+(:[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}|@sha256:[a-f0-9]{64})$"
          },
          "hudImage": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^@\\s]+(:[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}|@sha256:[a-f0-9]{64})$"
          },
          "databaseSecret": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
          },
          "serviceTlsSecret": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
          },
          "installationTlsSecret": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
          },
          "browserTlsSecret": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
          },
          "oidc": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "issuer": {
                "type": "string",
                "maxLength": 512,
                "pattern": "^(https://[^\\s?#]*[^\\s?#/])?$"
              },
              "clientId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._:-]{0,128}$"
              },
              "clientSecret": {
                "type": "string",
                "maxLength": 253,
                "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*)?$"
              },
              "requiredGroup": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._:-]{0,128}$"
              }
            }
          },
          "passwordSignIn": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "addresses": {
                "type": "array",
                "maxItems": 16,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[0-9A-Fa-f:.]{2,45}$"
                }
              }
            }
          }
        }
      },
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "investigationEnabled": {
          "type": "boolean"
        },
        "relay": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "jevEnabled": {
              "type": "boolean"
            }
          },
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "required": [
              "databaseSecret",
              "deliverySecret",
              "receiverOrigin"
            ],
            "properties": {
              "databaseSecret": {
                "type": "string",
                "minLength": 1,
                "maxLength": 253,
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
              },
              "deliverySecret": {
                "type": "string",
                "minLength": 1,
                "maxLength": 253,
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
              },
              "receiverOrigin": {
                "type": "string",
                "maxLength": 270,
                "pattern": "^https://(([a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?\\.)*[a-z]([-a-z0-9]{0,61}[a-z0-9])?|(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3})(:[1-9][0-9]{0,4})?$"
              }
            }
          }
        },
        "telemetryEnabled": {
          "type": "boolean"
        },
        "telemetryIdsSecret": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
        },
        "jevEnabled": {
          "type": "boolean"
        }
      }
    },
    "monitoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ids"
      ],
      "properties": {
        "ids": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "expectedScrapes"
          ],
          "properties": {
            "expectedScrapes": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "site",
                  "job",
                  "instance"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 63,
                    "pattern": "^[a-z0-9][a-z0-9-]*$"
                  },
                  "site": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[a-zA-Z0-9_.-]+$"
                  },
                  "job": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[^\\x00-\\x20\\x7f]+$"
                  },
                  "instance": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "pattern": "^[^\\x00-\\x20\\x7f]+$"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
