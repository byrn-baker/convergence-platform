{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "existingSecret": {
      "type": "string"
    },
    "siteConfig": {
      "type": "object",
      "minProperties": 1
    },
    "api": {
      "type": "object",
      "properties": {
        "rateLimitPerMinute": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "image": {
          "type": "object",
          "properties": {
            "tag": {
              "type": "string"
            }
          }
        },
        "service": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "ClusterIP",
                "NodePort"
              ]
            },
            "nodePort": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 30000,
              "maximum": 32767
            }
          }
        }
      }
    },
    "agentMetrics": {
      "type": "object",
      "properties": {
        "quota": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "modelRegex": {
              "type": "string"
            },
            "weeklyTokenBudget": {
              "type": [
                "number",
                "string"
              ],
              "minimum": 0
            },
            "projectionWarnRatio": {
              "type": [
                "number",
                "string"
              ],
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "burnCriticalRatio": {
              "type": [
                "number",
                "string"
              ],
              "exclusiveMinimum": 0,
              "maximum": 1
            }
          }
        }
      }
    }
  }
}
