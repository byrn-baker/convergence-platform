{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "existingSecret": {
      "type": "string"
    },
    "siteConfig": {
      "type": "object",
      "minProperties": 1
    },
    "api": {
      "type": "object",
      "properties": {
        "rateLimitPerMinute": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "image": {
          "type": "object",
          "properties": {
            "tag": {
              "type": "string"
            }
          }
        },
        "service": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "ClusterIP",
                "NodePort"
              ]
            },
            "nodePort": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 30000,
              "maximum": 32767
            }
          }
        }
      }
    },
    "agentMetrics": {
      "type": "object",
      "properties": {
        "quota": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "modelRegex": {
              "type": "string"
            },
            "weeklyTokenBudget": {
              "type": [
                "number",
                "string"
              ],
              "minimum": 0
            },
            "projectionWarnRatio": {
              "type": [
                "number",
                "string"
              ],
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "burnCriticalRatio": {
              "type": [
                "number",
                "string"
              ],
              "exclusiveMinimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "reviewer": {
      "type": "object",
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        },
        "required": [
          "enabled"
        ]
      },
      "then": {
        "required": [
          "publicOrigin",
          "apiImage",
          "hudImage",
          "databaseSecret",
          "serviceTlsSecret",
          "installationTlsSecret",
          "browserTlsSecret"
        ],
        "properties": {
          "publicOrigin": {
            "type": "string",
            "pattern": "^https://([a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?\\.)*[a-z]([-a-z0-9]{0,61}[a-z0-9])?(:[1-9][0-9]{0,4})?$",
            "maxLength": 270
          },
          "apiImage": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^@\\s]+(:[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}|@sha256:[a-f0-9]{64})$"
          },
          "hudImage": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^@\\s]+(:[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}|@sha256:[a-f0-9]{64})$"
          },
          "databaseSecret": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
          },
          "serviceTlsSecret": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
          },
          "installationTlsSecret": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
          },
          "browserTlsSecret": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
          }
        }
      },
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    }
  }
}
