+test('retained evidence and Site operations stay independent, with no remote owner bootstrap', async t => {
+  const calls = [];
+  const runtime = {kind:'openclaw', installationId:'11111111-1111-4111-8111-111111111111',
+    label:'OpenClaw', readiness:{ready:true}, capabilities:{convergence:true, siteOperations:true}};
+  const {document} = await app(t, false, async (url, options = {}) => {
+    calls.push([url, options]);
+    if (url === '/api/home/status') return Response.json({configured:false, localOwnerMode:false, reviewerOrigin:'https://review.example.test'});
+    return Response.json({});
+  }, runtime);
+  const retained = [...document.querySelectorAll('nav button')].find(b => b.textContent.endsWith('Convergence'));
+  assert.ok(retained);
+  const beforeOpen = calls.length;
+  click(document, 'Site operations');
+  await waitFor(() => document.querySelector('a[href="https://review.example.test/"]'), 'reviewer link');
+  assert.ok(!calls.slice(beforeOpen).some(([url, options]) =>
+    (url === '/api/hud/session' && options.headers?.has?.('X-NetClaw-Installation')) ||
+    (url.startsWith('/api/home/') && url !== '/api/home/status')));
+  retained.click();
+  await waitFor(() => document.querySelector('h1')?.textContent.startsWith('Convergence'), 'retained evidence');
+});
