+// ctx is the published surface modules may rely on — deliberately small, so it
+// can stay stable. Adding to it is a compatibility promise; prefer an issue over
+// quietly widening it.
+// Browser-editable runtime .env files cannot select a credential destination or reviewer origin.
+const hudDeploymentKeys = new Set(['CONVERGENCE_HUD_LOCAL_OWNER', 'CONVERGENCE_HUD_READ_TOKEN',
+  'CONVERGENCE_SITE', 'CONVERGENCE_API_URL', 'CONVERGENCE_REVIEWER_ORIGIN']);
+const moduleEnvLookup = (key) => {
+  if (hudDeploymentKeys.has(key)) return process.env[key] || '';
+  if (process.env[key] !== undefined && process.env[key] !== '') return String(process.env[key]);
+  for (const f of ENV_FILES) {
+    const v = parseOneEnvFile(f)[key];
+    if (v !== undefined && v !== '') return String(v);
+  }
+  return '';
+};
